{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "NothingBut Library",
  "version": "0.1.0",
  "identifier": "com.nothingbut.library",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "NothingBut Library",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://*.hdslb.com https://api.qrserver.com https://*.weread.qq.com https://wfqqreader-1252317822.image.myqcloud.com https://cdn.weread.qq.com https://res.weread.qq.com data:; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$HOME/Library/Application Support/**"
          ]
        }
      }
    }
  }
}
